# DocketWorks website — server-side configuration.
# Copy to `.env` and fill in. All of these are read server-side only (never
# exposed to the browser). In dev, anything left blank falls back to an obvious
# placeholder so the site still runs (forms log instead of sending, the demo
# link is a dummy). In production (NODE_ENV=production) every value is required.

# Where lead notifications are sent, and the "email us directly at ..." address
# shown if a form fails.
OPERATOR_EMAIL=

# Transactional email goes via O365 SMTP (smtp.office365.com:587, STARTTLS).
# SMTP_USER is the operator mailbox address. SMTP_PASSWORD is an *app password*
# generated at account.microsoft.com → Security → App passwords (NOT the
# account password). The mailbox also needs "Authenticated SMTP" enabled in
# the M365 admin centre — many tenants have it off by default.
SMTP_USER=
SMTP_PASSWORD=
# From-address for outgoing mail. For O365 this normally must equal SMTP_USER
# unless that mailbox has SendAs permission on another address.
EMAIL_FROM=

# The always-on shared demo site (a single fixed login the /demo form hands out).
SHARED_DEMO_URL=
SHARED_DEMO_USERNAME=
SHARED_DEMO_PASSWORD=

# Embed/booking link for the "book a walkthrough" scheduler (Cal.com or Calendly).
SCHEDULER_EMBED_URL=
