---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
---

<BaseLayout>
  <Hero
    headline="Keep a clear head across every job."
    subcopy="DocketWorks is software for businesses that quote and deliver custom, one-off jobs — where the real product is your team's hours."
    kicker="Built by a working sheet metal shop to run itself, every day."
    primaryCta={{ label: 'Try the live demo', href: '/demo' }}
    secondaryCta={{ label: 'See how it works', href: '/how-it-works' }}
  />

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6">
      <p class="text-sm text-primary-400">
        [ home page content — being built in phase B ]
      </p>
    </div>
  </section>

  <CtaBand
    headline="See it for yourself."
    subcopy="A real, working system — no call, no pitch."
  />
</BaseLayout>
