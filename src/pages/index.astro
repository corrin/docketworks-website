---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import QuestionList from '../components/sections/QuestionList.astro';
import Stat from '../components/sections/Stat.astro';
import FitBlock from '../components/sections/FitBlock.astro';
import FounderNote from '../components/sections/FounderNote.astro';
import VideoEmbed from '../components/sections/VideoEmbed.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Button from '../components/ui/Button.astro';

const questions = [
  'How many hours of billable work did the team do each day last week?',
  'Is there enough in the pipeline to keep everyone busy?',
  'A client just rang — when’s their job done?',
  'Someone broke their arm — how do you reassign their jobs, and what does that do to your delivery dates?',
];
---

<BaseLayout>
  <Hero
    headline="Keep a clear head across every job."
    subcopy="You came up doing the work. You built a name for it. You grew. Now the hard part isn’t any one job — it’s keeping a clear head across all of them at once, without the whole place living in one person’s head."
    kicker="Built by a working sheet metal shop to run itself — orders on dockets, dockets to the stations, the whole shop moving. It runs every day."
    primaryCta={{ label: 'Try the live demo', href: '/demo' }}
    secondaryCta={{ label: 'See how it works', href: '/how-it-works' }}
  />

  <QuestionList
    heading="The hard part isn’t any one job — it’s keeping a clear head across dozens at once."
    lead="A few questions a shop like yours should be able to answer in seconds:"
    questions={questions}
  />

  {/* Proof block — who built it, and what it changed */}
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">
            We built this to answer those — for our own shop.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-primary-700">
            Morris Sheetmetals is a working ~15-person sheet metal shop. Before
            DocketWorks it ran on paper folders and a whiteboard with handwritten
            job-number magnets — and the owner had almost no idea where the numbers
            stood until months later: how many quotes were going out, what share
            of the team’s hours actually got billed, whether the pipeline was full.
          </p>
          <p class="mt-4 text-base leading-relaxed text-primary-700">
            DocketWorks is the system that replaced the whiteboard. MSM runs on it
            every day. <a href="/who-its-for" class="font-medium text-accent-700 hover:text-accent-800">More on who built it &rarr;</a>
          </p>
        </div>
        <div class="space-y-6">
          <figure>
            <img
              src="/placeholder-msm-whiteboard.svg"
              alt="The whiteboard MSM used to run jobs on, before DocketWorks — handwritten job numbers on magnets"
              class="w-full rounded-xl border border-primary-200"
              loading="lazy"
            />
            <figcaption class="mt-2 text-sm text-primary-500">The “before”: the whiteboard MSM ran jobs on.</figcaption>
          </figure>
          <Stat
            label="of the team’s hours, billed — known, not guessed"
            caption="Before DocketWorks, MSM couldn’t have told you this figure. (Real number from MSM — coming.)"
          />
        </div>
      </div>
    </div>
  </section>

  {/* How it works in 30 seconds */}
  <section class="bg-primary-50 py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6">
      <h2 class="max-w-2xl text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">
        How it works, in 30 seconds.
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-primary-200 bg-white p-6">
          <p class="font-semibold text-primary-900">A staff member fills in their timesheet.</p>
          <p class="mt-2 text-base leading-relaxed text-primary-700">
            That gets them paid — <em>and</em> puts that time against a job. One entry, both things done.
          </p>
        </div>
        <div class="rounded-xl border border-primary-200 bg-white p-6">
          <p class="font-semibold text-primary-900">Someone raises a purchase order.</p>
          <p class="mt-2 text-base leading-relaxed text-primary-700">
            That orders the material — <em>and</em> puts the cost against a job. Again: one entry, both things.
          </p>
        </div>
      </div>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-primary-700">
        Underneath: a board for every job, reports, scheduling, and it keeps your
        suppliers’ price lists up to date for you. <a href="/how-it-works" class="font-medium text-accent-700 hover:text-accent-800">See how it works &rarr;</a>
      </p>
    </div>
  </section>

  <FitBlock heading="It already fits a shop like yours.">
    <p>
      DocketWorks is quick because it isn’t a build-your-own kit. It already knows
      how a shop like this runs — so there’s nothing to set up, no settings to
      fiddle with, and every field on the screen is there because the job needs it.
    </p>
    <p>
      The honest other side: if your shop works in a fundamentally different way, a
      tool with more switches will suit you better — and we’d rather say so early
      than waste your time. <a href="/who-its-for" class="font-medium text-accent-700 hover:text-accent-800">More on who it’s for &rarr;</a>
    </p>
    <p class="text-base text-primary-600">
      When I looked at WorkflowMax for my own shop, the dealbreaker was simple: I
      couldn’t enter a job into it faster than I could write it on paper. That’s
      the price a tool built to fit everyone tends to charge — and the one
      DocketWorks deliberately doesn’t.
    </p>
  </FitBlock>

  {/* Switching teaser */}
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6">
      <h2 class="max-w-2xl text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">
        Coming from a whiteboard, a spreadsheet, or Trello?
      </h2>
      <p class="mt-3 max-w-2xl text-lg text-primary-700">
        Most shops we work with aren’t switching from another job system — they’re
        coming off paper, a spreadsheet, Xero, or Trello. Here’s what changes.
      </p>
      <div class="mt-6">
        <Button href="/compare" variant="outline" size="md">See what changes</Button>
      </div>
    </div>
  </section>

  {/* Pricing one-liner */}
  <section class="bg-primary-50 py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6 text-center">
      <p class="flex items-baseline justify-center gap-2">
        <span class="text-4xl font-bold tracking-tight text-primary-900">$40</span>
        <span class="text-lg text-primary-600">per staff member / month.</span>
      </p>
      <p class="mt-3 text-lg text-primary-700">Everything in the box — no add-on modules. Works with Xero.</p>
      <div class="mt-6">
        <Button href="/pricing" variant="outline" size="md">See pricing</Button>
      </div>
    </div>
  </section>

  <FounderNote
    quote="I own a sheet metal shop. I built DocketWorks to run it — and we do, every day. It’s solid enough now that other shops like ours can use it too."
    name="Corrin"
    role="owner, Morris Sheetmetals — and DocketWorks"
    photo="/placeholder-corrin.svg"
    photoAlt="Corrin, owner of Morris Sheetmetals"
    link={{ label: 'Who it’s for', href: '/who-its-for' }}
  />

  <VideoEmbed
    poster="/placeholder-demo-video-poster.svg"
    posterAlt="DocketWorks demo video"
    caption="Watch the ~3-minute tour."
  />

  <CtaBand
    headline="See it for yourself — no call, no pitch."
    subcopy="Try the live demo, or grab a time to be walked through it."
  />
</BaseLayout>
