---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found — DocketWorks">
  <section class="bg-white py-24 md:py-32">
    <div class="mx-auto max-w-[var(--max-w-site)] px-6 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-primary-900 md:text-4xl">
        That page isn't here.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-primary-700">
        The link might be old, or we moved something. Here's the way back.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/" variant="primary" size="lg">Home</Button>
        <Button href="/demo" variant="outline" size="lg">Try the live demo</Button>
      </div>
    </div>
  </section>
</BaseLayout>
