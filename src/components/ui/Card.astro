---
interface Props {
  class?: string;
  variant?: 'default' | 'bordered' | 'elevated';
}

const { class: className, variant = 'default' } = Astro.props;

const variantClasses = {
  default: 'bg-white',
  bordered: 'bg-white border border-primary-200',
  elevated: 'bg-white shadow-lg shadow-primary-900/5',
};
---

<div class:list={['rounded-xl p-6', variantClasses[variant], className]}>
  <slot />
</div>
