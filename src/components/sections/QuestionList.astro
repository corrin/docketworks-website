---
interface Props {
  /** The line above the questions. */
  heading: string;
  /** Optional supporting line under the heading. */
  lead?: string;
  /** The questions — short, concrete, in the owner's words. */
  questions: string[];
  bg?: 'white' | 'light';
}

const { heading, lead, questions, bg = 'white' } = Astro.props;
const bgClass = bg === 'light' ? 'bg-primary-50' : 'bg-white';
---

<section class:list={[bgClass, 'py-16 md:py-24']}>
  <div class="mx-auto max-w-[var(--max-w-site)] px-6">
    <h2 class="max-w-2xl text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">
      {heading}
    </h2>
    {lead && <p class="mt-3 max-w-2xl text-lg text-primary-700">{lead}</p>}
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {questions.map((q, i) => (
        <li class="flex gap-4 rounded-xl border border-primary-200 bg-white p-6">
          <span class="text-2xl font-bold tabular-nums text-accent-500">{i + 1}</span>
          <span class="text-base leading-relaxed text-primary-800">{q}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
