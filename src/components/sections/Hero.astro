---
import Button from '../ui/Button.astro';

interface CtaSpec {
  label: string;
  href: string;
}

interface Props {
  /** Small line above the headline (optional). */
  eyebrow?: string;
  /** The headline. Use the default slot for rich markup instead, if needed. */
  headline: string;
  /** Supporting paragraph(s). */
  subcopy?: string;
  /** A short kicker line below the subcopy (e.g. the kitchen-dockets line). */
  kicker?: string;
  primaryCta?: CtaSpec;
  secondaryCta?: CtaSpec;
}

const { eyebrow, headline, subcopy, kicker, primaryCta, secondaryCta } = Astro.props;
---

<section class="bg-primary-50">
  <div class="mx-auto max-w-[var(--max-w-site)] px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{eyebrow}</p>
      )}
      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-primary-900 md:text-4xl">
        {headline}
      </h1>
      {subcopy && (
        <p class="mt-5 text-lg leading-relaxed text-primary-700">{subcopy}</p>
      )}
      {kicker && (
        <p class="mt-4 text-base italic leading-relaxed text-primary-500">{kicker}</p>
      )}
      <slot />
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {primaryCta && (
            <Button href={primaryCta.href} variant="primary" size="lg">{primaryCta.label}</Button>
          )}
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="outline" size="lg">{secondaryCta.label}</Button>
          )}
        </div>
      )}
    </div>
  </div>
</section>
