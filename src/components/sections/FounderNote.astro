---
interface Props {
  /** The note itself — short, owner-to-owner. */
  quote: string;
  name: string;
  /** e.g. "Owner, Morris Sheetmetals — and DocketWorks". */
  role?: string;
  photo: string;
  photoAlt: string;
  /** Optional "read more" link. */
  link?: { label: string; href: string };
  bg?: 'white' | 'light';
}

const { quote, name, role, photo, photoAlt, link, bg = 'white' } = Astro.props;
const bgClass = bg === 'light' ? 'bg-primary-50' : 'bg-white';
---

<section class:list={[bgClass, 'py-16 md:py-24']}>
  <div class="mx-auto max-w-[var(--max-w-site)] px-6">
    <figure class="flex max-w-3xl flex-col gap-6 sm:flex-row sm:items-start">
      <img
        src={photo}
        alt={photoAlt}
        class="h-20 w-20 flex-none rounded-full object-cover ring-1 ring-primary-200"
        loading="lazy"
      />
      <div>
        <blockquote class="text-xl leading-relaxed text-primary-800">{quote}</blockquote>
        <figcaption class="mt-4 text-sm text-primary-600">
          <span class="font-semibold text-primary-900">{name}</span>{role && <span> — {role}</span>}
        </figcaption>
        {link && (
          <a href={link.href} class="mt-3 inline-block text-sm font-medium text-accent-700 hover:text-accent-800">
            {link.label} &rarr;
          </a>
        )}
      </div>
    </figure>
  </div>
</section>
