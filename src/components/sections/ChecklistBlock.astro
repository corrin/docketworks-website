---
interface Props {
  heading: string;
  /** Optional line under the heading. */
  lead?: string;
  items: string[];
  /** A closing caveat line, e.g. "Every business is different somewhere…". */
  caveat?: string;
  bg?: 'white' | 'light';
}

const { heading, lead, items, caveat, bg = 'white' } = Astro.props;
const bgClass = bg === 'light' ? 'bg-primary-50' : 'bg-white';
---

<section class:list={[bgClass, 'py-16 md:py-24']}>
  <div class="mx-auto max-w-[var(--max-w-site)] px-6">
    <h2 class="max-w-2xl text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">{heading}</h2>
    {lead && <p class="mt-3 max-w-2xl text-lg text-primary-700">{lead}</p>}
    <ul class="mt-8 max-w-3xl space-y-3">
      {items.map((item) => (
        <li class="flex gap-3">
          <svg class="mt-1 h-5 w-5 flex-none text-accent-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.6a1 1 0 0 1-1.42.006l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.79 2.79 6.793-6.886a1 1 0 0 1 1.414-.006Z" clip-rule="evenodd" />
          </svg>
          <span class="text-base leading-relaxed text-primary-800">{item}</span>
        </li>
      ))}
    </ul>
    {caveat && <p class="mt-6 max-w-3xl text-sm italic leading-relaxed text-primary-500">{caveat}</p>}
  </div>
</section>
