---
/**
 * The demo video. If `videoUrl` is missing or a placeholder, shows just the
 * poster with a "demo video coming" badge — never a broken embed.
 */
interface Props {
  /** Embed/file URL for the video. Leave unset until the real one exists. */
  videoUrl?: string;
  poster: string;
  posterAlt?: string;
  /** Caption under the video, e.g. "Watch the ~3-min tour". */
  caption?: string;
  bg?: 'white' | 'light';
}

const { videoUrl, poster, posterAlt = 'Demo video', caption, bg = 'white' } = Astro.props;
const hasVideo = !!videoUrl && videoUrl.trim() !== '' && !videoUrl.includes('PLACEHOLDER');
const bgClass = bg === 'light' ? 'bg-primary-50' : 'bg-white';
---

<section class:list={[bgClass, 'py-16 md:py-24']}>
  <div class="mx-auto max-w-[var(--max-w-site)] px-6">
    <div class="mx-auto max-w-4xl">
      <div class="relative overflow-hidden rounded-xl border border-primary-200 bg-primary-900">
        {hasVideo ? (
          <video src={videoUrl} poster={poster} controls playsinline class="w-full"></video>
        ) : (
          <>
            <img src={poster} alt={posterAlt} class="w-full opacity-90" loading="lazy" />
            <span class="absolute left-4 top-4 rounded-md bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">
              Demo video coming
            </span>
          </>
        )}
      </div>
      {caption && <p class="mt-3 text-center text-sm text-primary-500">{caption}</p>}
    </div>
  </div>
</section>
