---
const currentYear = new Date().getFullYear();

const productLinks = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/who-its-for', label: "Who it's for" },
  { href: '/compare', label: 'Switching' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/demo', label: 'See it' },
];

const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="border-t border-primary-200 bg-primary-50">
  <div class="mx-auto max-w-[var(--max-w-site)] px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-primary-900">DocketWorks</p>
        <p class="mt-2 max-w-xs text-sm text-primary-500">
          Software for businesses that quote and deliver custom jobs — built by a
          working sheet metal shop to run itself.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold text-primary-700">Product</p>
        <ul class="mt-3 space-y-2">
          {productLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-primary-500 hover:text-primary-900">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-primary-700">Legal</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-primary-500 hover:text-primary-900">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-primary-200 pt-6">
      <p class="text-sm text-primary-400">&copy; {currentYear} DocketWorks.</p>
    </div>
  </div>
</footer>
